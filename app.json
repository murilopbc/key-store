{
  "expo": {
    "name": "Loja de Chaves",
    "slug": "loja-chaves-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.lojachaves.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.edu.lojachaves.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera para fotografar produtos e ler códigos de barras."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use o Face ID para desbloquear o app."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "scheme": "lojachaves"
  }
}
